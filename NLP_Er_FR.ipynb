    {
      "cell_type": "code",
      "source": [
        "def translate(text, model, tokenizer, max_len=64):\n",
        "    model.eval()\n",
        "    inputs = tokenizer(text, return_tensors=\"pt\", truncation=True, max_length=max_len).to(device)\n",
        "    with torch.no_grad():\n",
        "        generated = model.generate(**inputs, max_length=max_len, num_beams=4)\n",
        "    return tokenizer.decode(generated[0], skip_special_tokens=True)\n",
        "\n",
        "def translate_en_to_fr(text):\n",
        "    return translate(text, en_fr_model, en_fr_tokenizer)\n",
        "\n",
        "def translate_fr_to_en(text):\n",
        "    return translate(text, fr_en_model, fr_en_tokenizer)"
      ],
      "metadata": {
        "id": "Y8p5aBonveqp"
      },
      "execution_count": 16,
      "outputs": []
    },
